<!-- paralleltesting.xml -->
<suite name="OrangeHRM Parallel Suite" parallel="tests" thread-count="3">

    <test name="Chrome - Login">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Chrome - Employee">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.orangehrm.tests.EmployeeTest"/>
        </classes>
    </test>

    <test name="Firefox - Login">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox - Employee">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.orangehrm.tests.EmployeeTest"/>
        </classes>
    </test>

    <test name="Edge - Login">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.orangehrm.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Edge - Employee">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.orangehrm.tests.EmployeeTest"/>
        </classes>
    </test>

</suite>